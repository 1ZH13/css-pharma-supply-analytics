table existencias
	lineageTag: 9ebd92a6-c78d-4185-b565-91402f52f788

	measure 'Valor inventario' = CALCULATE ( SUM ( existencias[valor] ), existencias[atipico] = FALSE () )
		formatString: #,0
		lineageTag: 6c31d0d0-7fa2-4703-bcba-81aa29461000

	measure Unidades = CALCULATE ( SUM ( existencias[cantidad] ), existencias[atipico] = FALSE () )
		formatString: #,0
		lineageTag: 05208229-e703-47a5-b06a-ff9415513372

	measure 'Valor promedio mensual' = AVERAGEX ( SUMMARIZE ( existencias, Calendario[Date] ), [Valor inventario] )
		formatString: #,0
		lineageTag: 66fd7e05-77ed-485a-9557-685330ad85ba

	measure 'Valor año anterior' = CALCULATE ( [Valor inventario], DATEADD ( Calendario[Date], -12, MONTH ) )
		formatString: #,0
		lineageTag: 773ad94b-fc22-46fa-8e90-53dcd2ee9412

	measure 'Variación 12 meses %' = DIVIDE ( [Valor inventario] - [Valor año anterior], [Valor año anterior] )
		formatString: +0.0%;-0.0%
		lineageTag: 65f44838-6008-459f-94b2-2e443f02b912

	measure 'Dinero inmovilizado' = CALCULATE ( SUM ( riesgo_medicamentos[valor_existencia] ), riesgo_medicamentos[cobertura_meses] > 12 )
		formatString: #,0
		lineageTag: 9364d859-a191-4424-bdfe-338a5d3a99cf

	measure Renglones-mes = COUNTROWS ( SUMMARIZE ( existencias, Calendario[Date], existencias[codigo] ) )
		formatString: #,0
		lineageTag: 836a102e-d668-492a-89f2-14e4553d03cc

	measure 'Renglones en cero' = VAR t = ADDCOLUMNS ( SUMMARIZE ( existencias, Calendario[Date], existencias[codigo] ), "@q", CALCULATE ( SUM ( existencias[cantidad] ) ) ) RETURN COUNTROWS ( FILTER ( t, [@q] <= 0 ) )
		formatString: #,0
		lineageTag: 780fe8b6-887b-4e40-a636-dec60bd4f242

	measure '% abastecimiento' = 1 - DIVIDE ( [Renglones en cero], [Renglones-mes] )
		formatString: 0.0%
		lineageTag: 7f9328af-eb83-483d-a67c-1064a3650997

	measure 'Críticos en cero' = CALCULATE ( [Renglones en cero], medicamentos[critico] = TRUE () )
		formatString: 0
		lineageTag: b79b68aa-2814-4da1-a849-dad99e6f1387

	measure 'Abastecimiento oficial' = DIVIDE ( AVERAGE ( kpi_mensual[pct_abastecimiento] ), 100 )
		formatString: 0.0%
		lineageTag: 7b17a75f-f428-424a-8e0d-bf789cc577dd

	measure 'Abastecimiento último mes' = VAR u = MAX ( kpi_mensual[periodo] ) RETURN CALCULATE ( [Abastecimiento oficial], kpi_mensual[periodo] = u )
		formatString: 0.0%
		lineageTag: e9b2cbd2-be6b-43ac-b6bd-522465f43901

	measure 'Críticos en cero último mes' = VAR u = MAX ( kpi_mensual[periodo] ) RETURN CALCULATE ( SUM ( kpi_mensual[criticos_en_cero] ), kpi_mensual[periodo] = u )
		formatString: 0
		lineageTag: 1486006b-c030-41e3-a1ac-9a4197b43d76

	measure 'En riesgo alto' = CALCULATE ( COUNTROWS ( riesgo_medicamentos ), riesgo_medicamentos[nivel_riesgo] = "alto" )
		formatString: 0
		lineageTag: fdcbb669-6067-4589-83bf-032183d133a8

	measure 'Críticos en riesgo alto' = CALCULATE ( [En riesgo alto], riesgo_medicamentos[critico] = TRUE () )
		formatString: 0
		lineageTag: 90f26a29-7cb8-444d-8600-2c41f34faf31

	measure 'Traslados sugeridos' = COUNTROWS ( redistribucion )
		formatString: 0
		lineageTag: cb2939f1-db2f-42a9-aae6-2d1abcaa075a

	measure 'Valor de traslados' = SUM ( redistribucion[valor] )
		formatString: #,0
		lineageTag: 9867c7cc-0442-4d0b-bfc5-019280d9b5fb

	measure 'Brecha declarada (p.p.)' = AVERAGE ( p2_declaraciones[brecha_pp] )
		formatString: 0.0
		lineageTag: 7d496803-e9d6-44d4-b9c1-61bde192b1c5

	measure 'Valor último mes' = VAR u = CALCULATE ( MAX ( existencias[Fecha] ), ALL ( existencias ) ) RETURN CALCULATE ( [Valor inventario], existencias[Fecha] = u )
		formatString: #,0
		lineageTag: a864011e-aaff-4f35-bd8a-ad7a1b070ad8

	measure 'Medicamentos en riesgo' = COUNTROWS ( riesgo_medicamentos )
		formatString: 0
		lineageTag: ba9242df-d026-4b52-a510-9d702e87e41e

	measure 'Comprar ya' = CALCULATE ( [Críticos en riesgo alto], riesgo_medicamentos[accion] = "1 · Comprar ya" )
		formatString: 0
		lineageTag: fab2b8e2-3197-4a30-a996-902b3e9deaa2

	measure 'Reforzar compra' = CALCULATE ( [Críticos en riesgo alto], riesgo_medicamentos[accion] = "2 · Reforzar compra" )
		formatString: 0
		lineageTag: d267d49c-2d37-4031-87bd-28d04b707c42

	measure 'Traslados de críticos' = CALCULATE ( COUNTROWS ( redistribucion ), redistribucion[critico] = TRUE () )
		formatString: 0
		lineageTag: 719410a9-8358-44f3-94a2-36a5d27eaccc

